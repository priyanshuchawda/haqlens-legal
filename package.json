{
  "name": "haqlens-legal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "bun run build:api && bun run build:web && bun run scan:client-secrets",
    "build:api": "bun run --cwd apps/api build",
    "build:web": "bun run --cwd apps/web build",
    "dev:api": "bun run --cwd apps/api dev",
    "dev:web": "bun run --cwd apps/web dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -b",
    "test": "bun test apps packages",
    "test:component": "bun test apps/web/src/App.component.test.tsx",
    "test:coverage": "bun test --coverage --coverage-reporter=text apps packages",
    "test:integration": "bun test apps/api/src/app.test.ts",
    "test:e2e": "playwright test --project=chromium --grep-invert accessibility",
    "test:a11y": "playwright test --project=a11y --grep accessibility",
    "audit": "bun audit",
    "scan:secrets": "bun scripts/scan-secrets.ts",
    "scan:client-secrets": "bun scripts/check-client-secrets.ts",
    "validate:openapi": "bun scripts/validate-openapi.ts",
    "verify": "bun run format:check && bun run lint && bun run typecheck && bun run test && bun run audit && bun run scan:secrets && bun run validate:openapi"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/bun": "1.4.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.6",
    "globals": "17.12.0",
    "happy-dom": "20.14.5",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0"
  }
}
